# Base de datos (puerto 5433 para no chocar con un Postgres local)
DATABASE_URL="postgresql://campuseats:secreto123@localhost:5433/campuseats"
# Semana 11: el gateway se quedó con el 4000 (el público); el core se muda al 4001
PORT=4001

# JWT (Semana 8)
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRA="4h"

# Semana 11: el correo y el SMS se fueron al servicio de notificaciones
# (sus variables SMTP_* y SMS_* están ahora en servicios/notificaciones/.env.example)
NOTIFICACIONES_URL="http://localhost:4002"
PAGOS_URL="http://localhost:4003"
# El mismo valor en el .env de cada servicio interno: así saben que la orden viene del core
TOKEN_INTERNO="cambia-esto-por-un-secreto-compartido"
