# Servicio de notificaciones (semana 11). Copia este archivo a .env
PORT=4002
# El mismo valor que TOKEN_INTERNO en el .env del core: así sabe que la orden viene de él
TOKEN_INTERNO="cambia-esto-por-un-secreto-compartido"

# Lo que antes estaba en el .env del core (semana 9)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER="tu-usuario-generado@ethereal.email"
SMTP_PASS="tu-password-generado"

# "simulado" escribe en la consola; "twilio" usa la API real (cuesta dinero)
SMS_PROVEEDOR="simulado"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
